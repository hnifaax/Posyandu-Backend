Project posyandu_backend {
  database_type: 'PostgreSQL'
  Note: 'Database Sistem Informasi Pengelolaan Data Kader Posyandu'
}

Table users {
  id bigint [pk, increment]
  username varchar(50) [not null, unique]
  email varchar(100) [not null, unique]
  password_hash text [not null]
  role varchar(20) [not null]
  created_at timestamptz
}

Table kader_profiles {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  full_name varchar(120) [not null]
  phone varchar(20)
  address text
  assigned_since date
  created_at timestamptz
}

Table participants {
  id bigint [pk, increment]
  full_name varchar(120) [not null]
  participant_type varchar(20) [not null]
  nik varchar(16) [unique]
  birth_date date
  gender char(1)
  address text
  phone varchar(20)
  guardian_name varchar(120)
  notes text
  created_at timestamptz
  updated_at timestamptz
}

Table posyandu_schedules {
  id bigint [pk, increment]
  title varchar(150) [not null]
  activity_date date [not null]
  start_time time
  end_time time
  location varchar(200) [not null]
  description text
  created_by bigint
  created_at timestamptz
}

Table schedule_participants {
  id bigint [pk, increment]
  schedule_id bigint [not null]
  participant_id bigint [not null]
  attendance_status varchar(20)
  registered_at timestamptz

  indexes {
    (schedule_id, participant_id) [unique]
  }
}

Table examinations {
  id bigint [pk, increment]
  participant_id bigint [not null]
  kader_id bigint
  schedule_id bigint
  examination_date date [not null]
  weight_kg numeric(5,2)
  height_cm numeric(5,2)
  blood_pressure varchar(20)
  notes text
  created_at timestamptz
}

Table examination_types {
  id bigint [pk, increment]
  type_name varchar(100) [not null, unique]
  unit varchar(30)
  description text
}

Table examination_results {
  id bigint [pk, increment]
  examination_id bigint [not null]
  examination_type_id bigint [not null]
  result_value varchar(100) [not null]
  notes text

  indexes {
    (examination_id, examination_type_id) [unique]
  }
}

Ref: kader_profiles.user_id - users.id
Ref: schedule_participants.schedule_id > posyandu_schedules.id
Ref: schedule_participants.participant_id > participants.id
Ref: examinations.participant_id > participants.id
Ref: examinations.kader_id > users.id
Ref: examinations.schedule_id > posyandu_schedules.id
Ref: examination_results.examination_id > examinations.id
Ref: examination_results.examination_type_id > examination_types.id
Ref: posyandu_schedules.created_by > users.id
